# Copy to .env.local and adjust.

# MongoDB – an own database.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=nexus-maut

# Public URL of this app (redirect URI = APP_URL/auth/callback,
# post-logout URI = APP_URL/). Required in production.
APP_URL=http://localhost:3006

# nexusIdentity (OIDC provider). Register a *confidential* app there
# (Administration → Anwendungen) with the two URIs above.
NEXUS_ISSUER=http://localhost:3005
NEXUS_CLIENT_ID=
NEXUS_CLIENT_SECRET=

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the SMTP password
# saved in Admin. Required in production; changing it makes that password unreadable.
SECRET_KEY=

# E-mail via SMTP (Brevo: smtp-relay.brevo.com, port 587) – can also be set in
# Admin → E-Mail, which takes precedence. Without SMTP, development prints mails
# to the server console; production refuses.
NODE_MAILER_HOST=
NODE_MAILER_PORT=587
NODE_MAILER_USER=
NODE_MAILER_PASSWORD=
NODE_MAILER_FROM_MAIL=nexusMAUT <noreply@example.com>
